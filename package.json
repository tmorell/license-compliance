{
    "author": "Teo Morell <teomorell@gmail.com>",
    "bin": {
        "license-compliance": "bin/cli.js"
    },
    "bugs": {
        "url": "https://github.com/tmorell/license-compliance/issues"
    },
    "dependencies": {
        "chalk": "5.6.2",
        "commander": "14.0.3",
        "cosmiconfig": "9.0.2",
        "debug": "4.4.3",
        "joi": "18.2.3",
        "spdx-expression-parse": "5.0.0",
        "spdx-satisfies": "6.0.0",
        "tslib": "2.8.1",
        "xmlbuilder": "15.1.1"
    },
    "description": "License compliance checker",
    "devDependencies": {
        "@eslint/compat": "2.1.0",
        "@eslint/eslintrc": "3.3.6",
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/debug": "4.1.13",
        "@types/node": "26.1.1",
        "@types/sinon": "22.0.0",
        "@types/spdx-expression-parse": "4.0.0",
        "@types/spdx-satisfies": "6.0.0",
        "@typescript-eslint/eslint-plugin": "8.65.0",
        "@typescript-eslint/parser": "8.65.0",
        "ava": "7.0.0",
        "c8": "12.0.0",
        "eslint": "10.8.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-ava": "16.0.1",
        "esmock": "2.7.6",
        "madge": "8.0.0",
        "prettier": "3.9.6",
        "prettier-plugin-organize-imports": "4.3.0",
        "sinon": "22.1.0",
        "ts-node": "10.9.2",
        "tsc-watch": "7.2.1",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "exports": {
        ".": {
            "default": "./lib/index.js",
            "types": "./lib/index.d.ts"
        }
    },
    "files": [
        "/lib/**/*",
        "/bin/**/*"
    ],
    "homepage": "https://github.com/tmorell/license-compliance#readme",
    "keywords": [
        "cli",
        "compliance",
        "license"
    ],
    "license": "MIT",
    "main": "./lib/index.js",
    "name": "license-compliance",
    "overrides": {
        "madge": {
            "typescript": "$typescript"
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tmorell/license-compliance.git"
    },
    "scripts": {
        "all": "npm run build && npm run circular && npm run lint && npm run prettier && npm run test:ci",
        "build": "npm run cleanup && tsc -p tsconfig.build.json",
        "c8": "c8 ava",
        "circular": "madge --extensions ts --circular src",
        "cleanup": "rm -rf ./lib ./coverage",
        "coverage": "c8 report --reporter=html && npx open-cli ./coverage/index.html ",
        "coverage:ci": "c8 report --reporter=lcov",
        "debug:watch": "DEBUG=license-compliance:* DEBUG_COLORS=true tsc-watch --onSuccess 'node ./lib/index.js'",
        "lint": "eslint",
        "prettier": "prettier --check .",
        "test": "npm run typecheck && ava",
        "test:ci": "npm run typecheck && npm run c8",
        "test:watch": "ava --watch",
        "typecheck": "tsc --noEmit"
    },
    "type": "module",
    "types": "./lib/index.d.ts",
    "version": "3.0.1"
}
