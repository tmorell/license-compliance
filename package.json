{
    "author": "Teo Morell <teomorell@gmail.com>",
    "ava": {
        "extensions": [
            "ts"
        ],
        "files": [
            "!tests/util.ts"
        ],
        "require": [
            "ts-node/register"
        ],
        "tap": false,
        "timeout": "10s",
        "verbose": false
    },
    "bin": {
        "license-compliance": "./bin/cli.js"
    },
    "bugs": {
        "url": "https://github.com/tmorell/license-compliance/issues"
    },
    "dependencies": {
        "chalk": "4.1.2",
        "commander": "14.0.3",
        "cosmiconfig": "9.0.2",
        "debug": "4.4.3",
        "joi": "18.2.3",
        "spdx-expression-parse": "5.0.0",
        "spdx-satisfies": "6.0.0",
        "tslib": "2.8.1",
        "xmlbuilder": "15.1.1"
    },
    "description": "License compliance checker",
    "devDependencies": {
        "@eslint/compat": "2.1.0",
        "@eslint/eslintrc": "3.3.6",
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin-js": "4.4.1",
        "@types/debug": "4.1.13",
        "@types/node": "26.1.1",
        "@types/sinon": "22.0.0",
        "@types/spdx-expression-parse": "4.0.0",
        "@types/spdx-satisfies": "6.0.0",
        "@typescript-eslint/eslint-plugin": "8.65.0",
        "@typescript-eslint/parser": "8.65.0",
        "ava": "7.0.0",
        "eslint": "10.7.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-ava": "16.0.1",
        "madge": "8.0.0",
        "nyc": "18.0.0",
        "prettier": "3.9.6",
        "prettier-plugin-organize-imports": "4.3.0",
        "sinon": "22.1.0",
        "ts-node": "10.9.2",
        "tsc-watch": "7.2.1",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "exports": {
        ".": {
            "default": "./lib/index.js",
            "types": "./lib/index.d.ts"
        }
    },
    "files": [
        "/lib/**/*",
        "/bin/**/*"
    ],
    "homepage": "https://github.com/tmorell/license-compliance#readme",
    "keywords": [
        "cli",
        "compliance",
        "license"
    ],
    "license": "MIT",
    "main": "./lib/index.js",
    "name": "license-compliance",
    "nyc": {
        "all": true,
        "cache": false,
        "exclude": [
            "eslint.config.mjs",
            ".eslintrc.ext.json",
            ".license-compliancerc.js",
            "**/*.d.ts",
            "**/*.spec.ts",
            "coverage",
            "baseline",
            "tests/util.ts",
            "bin/cli.js",
            "src/index.ts"
        ],
        "extension": [
            ".ts"
        ]
    },
    "overrides": {
        "madge": {
            "typescript": "$typescript"
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tmorell/license-compliance.git"
    },
    "scripts": {
        "all": "npm run build && npm run circular && npm run lint && npm run prettier && npm run test:ci",
        "build": "npm run cleanup && tsc -p tsconfig.build.json",
        "circular": "madge --extensions ts --circular src",
        "cleanup": "rm -rf ./lib ./.nyc_output ./coverage",
        "coverage": "nyc report --reporter=html && npx open-cli ./coverage/index.html ",
        "coverage:ci": "nyc report --reporter=lcov",
        "debug:watch": "DEBUG=license-compliance:* DEBUG_COLORS=true tsc-watch --onSuccess 'node ./lib/index.js'",
        "lint": "eslint",
        "nyc": "nyc ava",
        "prettier": "prettier --check .",
        "test": "ava",
        "test:ci": "npm run nyc",
        "test:watch": "ava --watch"
    },
    "type": "commonjs",
    "types": "./lib/index.d.ts",
    "version": "4.0.0"
}
